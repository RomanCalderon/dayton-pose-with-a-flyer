{
  // Pose with a Flyer — operator config.
  // The first file that exists wins:
  //   1. C:/DaytonKiosk/kiosk.json
  //   2. kiosk.json next to the installed .exe
  //   3. the per-user app config directory
  //   4. this bundled file
  // Comments are allowed. Restart the app after editing.

  "start": {
    "mode": "qr"
    // "qr": scan a participant URL, then upload the photo.
    // "touch": full-screen touch to start, photo is discarded, thank-you email line hidden.
  },
  "idle": {
    "timeoutSeconds": 60,
    "previewTimeoutSeconds": 90,
    "thankYouAutoReturnSeconds": 8,
    "stillThereWarningSeconds": 0
  },
  "roster": {
    "default": "mens",
    "maxSelections": 2
  },
  "athletes": {
    "singleSelectionSide": "random"
  },
  "features": {
    "multitouchAdjust": true,
    "plusMinusButtons": true,
    "rotateButton": false,
    "debugOverlay": false
  },
  "adjust": {
    // Gap between the visible player and the +/− buttons, in stage px at 3840×2160.
    // Used on the right, and again when the column flips to the left.
    // Negative overlaps the artwork. The buttons are still kept on screen.
    "sizeButtons": {
      "offsetX": 24
    }
  },
  "uploader": {
    // Host port of the uploader container (it listens on :5000 inside Docker).
    "baseUrl": "http://localhost:5001",
    "uploadPath": "/upload",
    "requestTimeoutMs": 8000,
    "fileField": "image",
    "interactiveId": "",
    "extraFields": false
  },
  "qr": {
    // auto: a plain value is the id. A URL uses participant_id, participantId, pid, or id,
    // then the last non-empty path segment. query / pathSegment / regex / raw are the other modes.
    "participantId": {
      "from": "auto",
      "param": "participant_id",
      "segment": -1,
      "pattern": ""
    }
  },
  "assets": {
    "root": "",
    "rosterFile": "roster.json",
    "headshotsDir": "headshots",
    "athleteVideosDir": "athletes",
    // Static plate. The real collage stays out of this public repo; drop it on the arena PC.
    "background": "branding/background.jpg",
    // Empty plays nothing. A path plays only on the attract screen, above the plate.
    "attractVideo": "",
    "takeawayFrame": "frames/takeaway_v1.png",
    "fireVideo": "fx/fire.mp4"
  },
  "cameras": {
    "photo": {
      "role": "top-center user feed + photo",
      "match": {
        "by": "label",
        "serial": "",
        "usbPort": "",
        "label": "",
        "deviceId": ""
      },
      "width": 1280,
      "height": 720,
      "fps": 30,
      "mirrorPreview": true
    },
    "qr": {
      "role": "side QR scanner",
      "match": {
        "by": "label",
        "serial": "",
        "usbPort": "",
        "label": "",
        "deviceId": ""
      },
      "width": 1280,
      "height": 720,
      "fps": 30,
      "scanIntervalMs": 150
    },
    "onMissing": "fallback"
  },
  "capture": {
    // true: show placeholders/guest.png when the photo camera has no live frame.
    // false: plain black behind the athletes, and the guest file is not loaded.
    "guestPlaceholder": true
  },
  "output": {
    "width": 2560,
    "height": 1440,
    "format": "image/jpeg",
    "quality": 0.9
  },
  "countdown": {
    // LOCK appears on the first live photo frame. The other words follow across
    // revealFraction of the countdown. Each word fades in over 60ms. color stays
    // solid for fadeDelayMs at opacity, then the block fades across
    // fadeDurationFraction of the countdown (not of the reveal). On a 10s
    // countdown that is LOCK at 0s, POSE at 2s, and a fade from 1s to 6s.
    "lockTitle": {
      "enabled": true,
      "color": "#FFFFFF",
      "opacity": 1,
      "revealFraction": 0.2,
      "fadeDelayMs": 1000,
      "fadeDurationFraction": 0.5
    }
  },
  "timing": {
    "countdownFrom": 10,
    "walkInStartsAt": 6,
    "freezeBeforeCaptureMs": 2000,
    "flashMs": 300
  },
  "render": {
    "stageResolution": [2560, 1440]
  },
  "window": {
    "fullscreen": false,
    "width": 1600,
    "height": 900,
    "alwaysOnTop": false
  },
  "debug": {
    "simulateScanUrl": "https://example.test/checkin?participant_id=1001",
    "allowKeyboard": true,
    "showHints": true
  },
  "pick": {
    // Button 275.145, gap 60, pitch 335.145, origin (130, 1009).
    // columns = clamp(max(minColumns, ceil((N - row3Max) / 2)), minColumns, maxColumns).
    // Rows 1 and 2 hold that many. Row 3 holds the rest, at most row3Max.
    // 19 is 7/7/5. 20 is 8/8/4. 27 is 11/11/5. Over maxPlayers, the first maxPlayers show.
    "grid": {
      "button": 275.145,
      "gap": 60,
      "origin": { "x": 130, "y": 1009 },
      "minColumns": 7,
      "maxColumns": 11,
      "row3Max": 5,
      "maxPlayers": 27
    },
    // Tall stills are sized from the old 177.468px window, then zoomed, and anchored to its top.
    // The circle is the only clip. zoom 1.18 shows about the top 32% of a 564×2000 still.
    // offsetY from -1 to 1 is a fraction of the image height; any other value is pixels.
    // Positive offsetY moves the crop down. nameInset pulls the arc down from the rim.
    "headshot": {
      "zoom": 1.18,
      "offsetX": 0,
      "offsetY": 0
    },
    "nameInset": 12
  },
  "attract": {
    "rotation": {
      "enabled": true,
      "holdMs": 6000,
      "outMs": 700,
      "inMs": 900,
      "offsetX": 100,
      "keyWhite": false
    }
  }
}
